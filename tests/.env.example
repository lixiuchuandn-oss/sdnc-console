# 复制为 tests/.env 后按本机修改（.env 勿提交 git）

# ---------- Tower 连接 ----------
TOWER_WEB_BASE=http://127.0.0.1:5000
TOWER_API_BASE=http://127.0.0.1:5001
TOWER_ADMIN_USER=admin
TOWER_ADMIN_PASSWORD=admin123
TOWER_CLOUD_ID=
TOWER_IMAGE_NAMESPACE=default

# ---------- 镜像：本地上传（upload-sync / api:chunks）----------
TOWER_IMAGE_FILE_PATH=D:\网元镜像\ubuntu_4_0_20.04_x86_1000G.qcow2

# ---------- 镜像：URL 导入（url-import）----------
TOWER_IMAGE_IMPORT_URL=http://10.21.0.31:48090/generic/3rd//centos_4_0_7.6_x86_100Gmini_cloudinit.qcow2

# ---------- 镜像：通用 ----------
TOWER_IMAGE_NAME_PREFIX=tower-e2e
TOWER_IMAGE_UPLOAD_TIMEOUT_MS=1800000
TOWER_IMAGE_SYNC_TIMEOUT_MS=3600000

# ---------- Cloudmap ----------
TOWER_CLOUDMAP_ENDPOINT=https://10.21.180.180/v3
TOWER_CLOUDMAP_TOKEN=

# ---------- CSM 安全资源池 E2E ----------
# 未设 TOWER_CSM_CLOUD_ID 时按 endpoint 片段或首个 online CSM 池
TOWER_CSM_CLOUD_ID=
TOWER_CSM_ENDPOINT_HINT=10.21.17.68
# 配置后可断言租户 BFF 200（CSM Web 登录 RSA 密文，非明文）
TOWER_CSM_REPAIR_USERNAME=admin
TOWER_CSM_REPAIR_PASSWORD_ENCRYPTED=
TOWER_CSM_WEB_PORT=8011
# 设为 1 时强制要求 GET .../csm/tenants 返回 200
TOWER_CSM_TENANTS_REQUIRE_OK=0

# ---------- 故障域 E2E ----------
TOWER_FD_NAME_PREFIX=tower-e2e-fd
TOWER_FD_DOMAIN_NAME=
TOWER_FD_NODE_NAME=

# ---------- 浏览器（默认有头；无头时设 HEADLESS=1）----------
HEADED=1
# Allure 原始结果目录（默认 tests/allure-results）；HTML 报告见 npm run allure:report
# ALLURE_RESULTS_DIR=allure-results
