# 复制为 tests/.env 后按本机修改（.env 勿提交 git）

# ---------- Tower 连接 ----------
TOWER_WEB_BASE=http://127.0.0.1:5000
TOWER_API_BASE=http://127.0.0.1:5001
TOWER_ADMIN_USER=admin
TOWER_ADMIN_PASSWORD=admin123

# ---------- 浏览器（默认有头；无头时设 HEADLESS=1）----------
HEADED=1
# Allure 原始结果目录（默认 tests/allure-results）；HTML 报告见 npm run allure:report
# ALLURE_RESULTS_DIR=allure-results
