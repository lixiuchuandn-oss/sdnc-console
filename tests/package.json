    "test:smoke:network": "playwright test smoke/network-tabs.browser.test.cjs",
    "test:smoke:storage": "playwright test smoke/storage-tabs.browser.test.cjs",
    "test:smoke:backups": "playwright test smoke/backups-tabs.browser.test.cjs",
    "test:smoke:overview": "playwright test smoke/overview-tabs.browser.test.cjs",
    "test:smoke:containers": "playwright test smoke/containers-tabs.browser.test.cjs",
    "test:smoke:monitoring": "playwright test smoke/monitoring-tabs.browser.test.cjs",
