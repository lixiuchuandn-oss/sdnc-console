    "manual:shots:vm": "node manual/capture-ch03-vm-create.browser.cjs",
    "manual:shots:volumes": "node manual/capture-ch03-volumes.browser.cjs",
    "manual:shots:backups": "node manual/capture-ch03-backups.browser.cjs",
    "manual:shots:vm-detail": "node manual/capture-ch03-vm-detail.browser.cjs",
    "manual:shots:network": "node manual/capture-ch03-network.browser.cjs",
    "manual:shots:monitoring": "node manual/capture-ch03-monitoring.browser.cjs",
    "manual:shots:overview": "node manual/capture-ch03-overview.browser.cjs",
    "manual:shots:cluster": "node manual/capture-ch03-cluster.browser.cjs",
    "manual:shots:containers": "node manual/capture-ch03-containers.browser.cjs",
