{
  "name": "compute-tower-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Compute Tower business-domain tests",
  "scripts": {
    "postinstall": "playwright install chromium",
    "test:api": "npm run test:auth:api && npm run test:failure-domains:api",
    "allure:report": "allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report",
    "pw": "playwright test",
    "test:browser": "playwright test auth/admin-login.browser.test.cjs harvester/images/browser-list-filter.browser.test.cjs harvester/failure-domains/browser-crud.browser.test.cjs harvester/failure-domains/browser-assign-filter.browser.test.cjs && npm run allure:report",
    "test:browser:headed": "node shared/run-npm-headed.cjs test:browser",
    "test:browser:auth": "playwright test auth/admin-login.browser.test.cjs && npm run allure:report",
    "test:browser:auth:headed": "node shared/run-headed.cjs auth/admin-login.browser.test.cjs",
    "test:browser:harvester": "playwright test harvester/images/browser-list-filter.browser.test.cjs harvester/failure-domains/browser-crud.browser.test.cjs harvester/failure-domains/browser-assign-filter.browser.test.cjs && npm run allure:report",
    "test:browser:harvester:headed": "node shared/run-npm-headed.cjs test:browser:harvester",
    "test:auth:api": "node auth/admin-login.api.test.cjs",
    "test:auth:browser": "playwright test auth/admin-login.browser.test.cjs && npm run allure:report",
    "test:cloudmap:connection": "node cnmc/cloudmap/pool-test-connection.api.test.cjs",
    "test:cloudmap:create": "node cnmc/cloudmap/pool-create.api.test.cjs",
    "test:images:contract": "node harvester/images/contract-list-state.cjs",
    "test:images:all": "node shared/run-images-all.cjs",
    "test:images:api": "npm run test:images:api:list && npm run test:images:api:task && npm run test:images:api:chunks && npm run test:images:api:policy && npm run test:images:api:token && npm run test:images:api:concurrency",
    "test:images:api:list": "node harvester/images/api-list.api.test.cjs",
    "test:images:api:task": "node harvester/images/api-upload-task.api.test.cjs",
    "test:images:api:chunks": "node harvester/images/api-upload-chunks.api.test.cjs",
    "test:images:api:policy": "node harvester/images/api-upload-policy.api.test.cjs",
    "test:images:api:token": "node harvester/images/api-upload-token.api.test.cjs",
    "test:images:api:concurrency": "node harvester/images/api-upload-concurrency.api.test.cjs",
    "test:images:browser": "playwright test harvester/images/browser-upload-and-sync.browser.test.cjs harvester/images/browser-list-filter.browser.test.cjs harvester/images/browser-url-import.browser.test.cjs && npm run allure:report",
    "test:images:browser:headed": "node shared/run-npm-headed.cjs test:images:browser",
    "test:images:browser:filter": "playwright test harvester/images/browser-list-filter.browser.test.cjs && npm run allure:report",
    "test:images:upload-sync": "playwright test harvester/images/browser-upload-and-sync.browser.test.cjs && npm run allure:report",
    "test:images:url-import": "playwright test harvester/images/browser-url-import.browser.test.cjs && npm run allure:report",
    "test:failure-domains:api": "node harvester/failure-domains/api-crud.api.test.cjs",
    "test:failure-domains:browser": "playwright test harvester/failure-domains/browser-crud.browser.test.cjs && npm run allure:report",
    "test:failure-domains:browser-filter": "playwright test harvester/failure-domains/browser-assign-filter.browser.test.cjs && npm run allure:report",
    "manual:shots:images": "node harvester/images/capture-manual-screenshots.browser.cjs",
    "manual:shots:pool": "node manual/capture-ch02-pool.browser.cjs",
    "manual:shots:vm": "node manual/capture-ch03-vm-create.browser.cjs",
    "manual:shots:volumes": "node manual/capture-ch03-volumes.browser.cjs",
    "manual:shots:backups": "node manual/capture-ch03-backups.browser.cjs",
    "manual:shots:vm-detail": "node manual/capture-ch03-vm-detail.browser.cjs",
    "manual:shots:network": "node manual/capture-ch03-network.browser.cjs",
    "manual:shots:monitoring": "node manual/capture-ch03-monitoring.browser.cjs",
    "manual:shots:overview": "node manual/capture-ch03-overview.browser.cjs",
    "manual:shots:cluster": "node manual/capture-ch03-cluster.browser.cjs",
    "manual:shots:containers": "node manual/capture-ch03-containers.browser.cjs",
    "manual:shots:misc": "node manual/capture-ch03-misc.browser.cjs",
    "manual:shots:enable-md": "node manual/enable-manual-assets.cjs",
    "manual:shots:all": "npm run manual:shots:pool && npm run manual:shots:images && npm run manual:shots:vm && npm run manual:shots:volumes && npm run manual:shots:backups && npm run manual:shots:vm-detail && npm run manual:shots:network && npm run manual:shots:monitoring && npm run manual:shots:overview && npm run manual:shots:cluster && npm run manual:shots:containers && npm run manual:shots:misc && npm run manual:shots:enable-md"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.9.0",
    "playwright": "1.60.0"
  }
}
