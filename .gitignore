# =============================================================================
# Compute.Tower · .gitignore
# 可提交文档：AGENTS.md（入口）、docs/（Hub 子文档）、源码内 README / STRUCTURE.md
# =============================================================================

# --- 操作系统 / 编辑器 ---
.DS_Store
Thumbs.db

# --- 通用构建产物与日志（任意目录）---
node_modules/
dist/
build/
coverage/
*.log

# --- 环境变量（任意目录）---
.env
.env*

# --- 本地便携工具链（如编译 ImageUploader 时解压的 Go SDK，勿入库）---
/.tools/
/tools/uploader/ImageUploader.exe
/tools/uploader/*.exe~

# --- 仓库根：运行期数据与本地专用目录（勿入库）---
# 运行期数据请使用 backend/data（在 backend 目录启动）；勿在仓库根再落 data/
/data/
/doc/
/deployment/
/release/
/remote/
/bug/
/design/

# --- backend/ ---
/backend/node_modules/
/backend/dist/
/backend/coverage/
/backend/.env
/backend/.env*
/backend/data/
/backend/*.sqlite
/backend/*.sqlite-shm
/backend/*.sqlite-wal
/backend/*.sqlite-journal
/backend/data.sqlite-shm
/backend/data.sqlite-wal
/backend/_boot-err.txt
/backend/_boot-out.txt
/backend/temp_uploads/
/backend/uploads/
/backend/tests/
/backend/scripts/
/backend/keys/license-signing-private.pem
/backend/verify_acl.js
/backend/public/
/backend/tools/

# --- frontend/ ---
/frontend/node_modules/
/frontend/node_modules/.cache/
/frontend/build/
/frontend/coverage/
/frontend/.env
/frontend/.env*

# --- e2e 自动化（不进业务仓库，与 backend/tests 同理；测试代码在 e2e/ 内单独 git 维护）---
/e2e/

# --- tests/ 业务域测试（与 backend/frontend 同级）---
/tests/.env
!tests/.env.example
/tests/node_modules/

# --- 本地任务 / 草稿 / 外部快照 ---
do/
plan/
design/
harvester-master/
1.md
2.md
.playwright-cli/
temp_*.py
