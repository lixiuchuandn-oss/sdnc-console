{
  "name": "compute-tower-frontend",
  "version": "1.0.3",
  "description": "Compute Tower SDNC IBR 控制台前端",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "antd": "^5.29.3",
    "axios": "^1.6.2",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.19",
    "http-proxy-middleware": "^3.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-flow-renderer": "^10.3.17",
    "react-router-dom": "^6.20.1",
    "react-scripts": "5.0.1",
    "typescript": "4.9.5"
  },
  "scripts": {
    "postinstall": "patch-package",
    "prepare": "husky install || echo 'Husky already installed'",
    "start": "cross-env HOST=0.0.0.0 PORT=5000 REACT_APP_PRODUCT_FLAVOR=sdnc REACT_APP_API_URL=http://127.0.0.1:5001 NODE_OPTIONS=--max-old-space-size=4096 react-scripts start",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 react-scripts build",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=4096 react-scripts test",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "eject": "react-scripts eject"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-dispatch": "3.0.6",
    "@types/jest": "^29.5.8",
    "cross-env": "^7.0.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "patch-package": "^8.0.1"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(axios)/)"
    ],
    "moduleNameMapper": {
      "^axios$": "axios/dist/node/axios.cjs"
    }
  },
  "proxy": "http://localhost:5001",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
