{
  "name": "compute-tower-frontend",
  "version": "1.0.2",
  "description": "Compute Tower 多云管理平台前端",
  "private": true,
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^5.6.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/legacy-modes": "^6.5.2",
    "@novnc/novnc": "^1.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@uiw/react-codemirror": "^4.25.8",
    "antd": "^5.29.3",
    "axios": "^1.6.2",
    "buffer": "^6.0.3",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.11.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "http-proxy-middleware": "^3.0.5",
    "js-yaml": "^4.1.1",
    "novnc-core": "^0.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-flow-renderer": "^10.3.17",
    "react-router-dom": "^6.20.1",
    "react-scripts": "5.0.1",
    "reactflow": "^11.11.4",
    "typescript": "4.9.5",
    "web-vitals": "^3.5.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "prepare": "husky install || echo 'Husky already installed'",
    "start": "set \"HOST=0.0.0.0\" && set \"PORT=5000\" && set \"REACT_APP_API_URL=http://127.0.0.1:5001\" && set \"NODE_OPTIONS=--max-old-space-size=4096\" && react-scripts start",
    "build": "set \"NODE_OPTIONS=--max-old-space-size=4096\" && react-scripts build",
    "test": "set \"NODE_OPTIONS=--max-old-space-size=4096\" && react-scripts test",
    "eject": "react-scripts eject"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-dispatch": "3.0.6",
    "@types/jest": "^29.5.8",
    "@types/novnc__novnc": "^1.6.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(axios)/)"
    ],
    "moduleNameMapper": {
      "^axios$": "axios/dist/node/axios.cjs"
    }
  },
  "proxy": "http://localhost:5001",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
