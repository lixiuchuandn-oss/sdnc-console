#!/bin/bash
set -x
show_help() {
	printf "Usage:\n"
	printf "  monitoring [OPTIONS...]\n"
	printf "\n"
	printf "Runs Monitoring Agent for collecting and sending data.\n"
	printf "\n"
	printf "General options:\n"
	printf "  -h, --help\t\t\t\t: Show this help text\n"
	printf "  -v, --version\t\t\t\t: Shows version of the agent.\n"
	printf "  --mode <send, collect, download>\t\t: Mode for running Monitoring Agent.\n"
	printf "Config options:\n"
	printf "  --auth <auth>\t\t\t\t: AUTH of the device.\n"
	printf "  --tonce <tonce>\t\t\t\t: TONCE of the device.\n"
	printf "Monitoring Config options:\n"
	printf "  --interval <time>\t\t\t: Time in seconds after which data should be sent/collected.\n"
	printf "  --max-retries <max-retries-count>\t: No. of time agent should retry to send data.\n"
	exit 0
}

show_version() {
	VERSION=$(vctl show version)
	echo "$VERSION"
	exit 0
}

echoerr() { echo "$@" 1>&2 && exit 1; }

check_md5() {
	local file=$1
	local file_old=$2
	local md5 md5_old
	md5=$(md5sum "$file" | awk '{print $1}')
	md5_old=$(md5sum "$file_old" | awk '{print $1}')
	if [ "$md5" = "$md5_old" ]; then
		return 0
	else
		return 1
	fi
}


get_mac() {
	local mac interface
	interface=$(ip link show | grep -v "lo" | grep -v "docker" | grep -v "veth" | grep -v "br-" | awk -F: '$0 !~ "^ " {print $2}' | head -n 1 | tr -d ' ')
	mac=$(ip link show $interface | awk '/ether/ {print $2}')
	echo "$mac"
}
get_uuid() {
	# 从VR_CONF文件中读取UUID
    local uuid=$(jq -r .uuid < "$VR_CONF" 2>/dev/null)
    
    # 如果UUID存在且不为空，直接返回
    if [ -n "$uuid" ] && [ "$uuid" != "null" ]; then
        echo "$uuid"
        return
    fi
