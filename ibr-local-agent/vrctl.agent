#!/bin/bash
# shellcheck disable=SC2039
# shellcheck disable=SC3043
set -x
# parse options
while [ -n "$1" ]; do
	case "$1" in
		--version | -v)
			export VERSION=1
			break
			;;
		--url)
			export URL="${2%/}" #去除URL最后的斜杠
			shift #shift 命令用于将参数列表中的参数向左移动，每次移动一个位置，直到没有参数为止。
			;; # strip trailing slash
		--interval)
			export INTERVAL="$2" 
			shift
			;;
		--management_interval)
			export MANAGEMENT_INTERVAL="$2"
			shift
			;;
		--registration_interval)
			export REGISTRATION_INTERVAL="$2"
			shift
			;;
		--check_interval)
			export CHECK_INTERVAL="$2"
			shift
			;;
		--auth_interval)
			export AUTH_INTERVAL="$2"
			shift
			;;
		--verify-ssl)
			export VERIFY_SSL="$2"
			shift
			;;
		--auth-id)
			export AUTH="$2"
			shift
			;;
		--tonce)
			export TONCE="$2"
			shift
			;;
		--verbose)
			export VERBOSE_MODE="$2"
			shift
			;;
		--shared-secret)
			export SHARED_SECRET="$2"
			shift
			;;
		--consistent-key)
			export CONSISTENT_KEY="$2"
			shift
			;;
		--hardware-id-script)
			export HARDWARE_ID_SCRIPT="$2"
			shift
			;;
		--hardware-id-key)
			export HARDWARE_ID_KEY="$2"
			shift
			;;
		--bootup-delay)
			export BOOTUP_DELAY="$2"
			shift
			;;
		--merge-config)
			export MERGE_CONFIG="$2"
			shift
			;;
		--unmanaged)
			export UNMANAGED="$2"
			shift
			;;
		--test-config)
			export TEST_CONFIG="$2"
			shift
			;;
		--test-retries)
			export TEST_RETRIES="$2"
			shift
			;;
		--test-script)
			export TEST_SCRIPT="$2"
			shift
			;;
		--connect-timeout)
			export CONNECT_TIMEOUT="$2"
			shift
			;;
		--max-time)
			export MAX_TIME="$2"
			shift
			;;
		--capath)
			export CAPATH="$2"
			shift
			;;
		--cacert)
			export CACERT="$2"
			shift
			;;
		--mac-interface)
			export MAC_INTERFACE="$2"
			shift
			;;
		--management-interface)
			export MANAGEMENT_INTERFACE="$2"
			shift
			;;
		--default-hostname)
			export DEFAULT_HOSTNAME="$2"
			shift
			;;
		--pre-reload-hook)
			export PRE_RELOAD_HOOK="$2"
			shift
			;;
		--post-reload-hook)
			export POST_RELOAD_HOOK="$2"
			shift
			;;
		--post-reload-delay)
			export POST_RELOAD_DELAY="$2"
			shift
			;;
		--post-registration-hook)
			export POST_REGISTRATION_HOOK="$2"
			shift
			;;
		--checksum-max-retries)
			export CHECKSUM_MAX_RETRIES="$2"
			shift
			;;
		--checksum-retry-delay)
			export CHECKSUM_RETRY_DELAY="$2"
			shift
			;;
		-*)
			echo "Invalid option: $1"
			exit 1
			;;
		*) break ;;
	esac
	shift #两个shift 命令用于将参数列表中的参数向左移动两次
done

if [ -n "$VERSION" ] && [ "$VERSION" -eq "1" ]; then
	VERSION=$(vctl show version)
	echo "$VERSION"
	exit 0
fi

#logger默认路径/var/log/syslog


FETCH_COMMAND="curl -s -k -X POST --connect-timeout 30"
MANAGEMENT_INTERFACE=${MANAGEMENT_INTERFACE:-$(ip route | grep "default" | awk '{print $5}')}
WORKING_DIR="/rhos/etc/agent"
AUTH_INFO="$WORKING_DIR/auth_info"
REGISTRATION_INFO="$WORKING_DIR/registration_info"
CONF="$WORKING_DIR/vr_conf"
INTERVAL=${INTERVAL:-120} #INTERVAL 默认值为120 ：- 表示如果INTERVAL没有设置，则使用120作为默认值
CHECK_INTERVAL=${CHECK_INTERVAL:-$((INTERVAL / 10))}
AUTH_INTERVAL=${AUTH_INTERVAL:-$((INTERVAL / 10))} #AUTH_INTERVAL 默认值为INTERVAL / 10
REGISTRATION_INTERVAL=${REGISTRATION_INTERVAL:-$((INTERVAL / 4))} #REGISTRATION_INTERVAL 默认值为INTERVAL / 4
POST_AUTH_HOOK=${POST_AUTH_HOOK:-/rhos/etc/agent/post-auth-hook}
POST_REGISTRATION_HOOK=${POST_REGISTRATION_HOOK:-/rhos/etc/agent/post-registration-hook}
VERBOSE_MODE=${VERBOSE_MODE:-0}
POOL_ID="" 
VM_ID=""
POOL_NAME=""
MANAGEMENT_IP=""


get_version() { 
	VERSION=$(vctl show version) 
	echo "$VERSION"
}
# 验证MAC地址格式是否有效
is_valid_mac() {
    local mac="$1"
    # MAC地址正则表达式：XX:XX:XX:XX:XX:XX 格式，其中X是十六进制数字
    if [[ $mac =~ ^([0-9A-Fa-f]{2}:){5}([0-9A-Fa-f]{2})$ ]]; then
        return 0  # 有效
    else
        return 1  # 无效
    fi
}

# 生成符合标准的随机MAC地址
generate_random_mac() {
    # 生成前三个字节：使用02开头（本地管理地址），确保符合MAC地址标准
    local mac="02"
    
    # 生成剩余五个字节的随机十六进制数字（共10个十六进制字符）
    # 循环生成，确保获得足够的十六进制字符
    local random_hex=""
    while [ ${#random_hex} -lt 10 ]; do
        # 生成随机字节，转换为十六进制，过滤出有效字符
        local temp=$(head -c 8 /dev/urandom | xxd -p 2>/dev/null || head -c 16 /dev/urandom | base64 | tr -dc '0-9a-fA-F')
        random_hex="$random_hex$temp"
        # 截取前10个字符
        random_hex=${random_hex:0:10}
    done
    
    # 将随机十六进制字符串格式化为XX:XX:XX:XX:XX格式
    for ((i=0; i<10; i+=2)); do
        mac="$mac:${random_hex:i:2}"
    done
    
    echo "$mac"
}

get_mac() {
	# 身份由 Paas-VRv2 写入 registervr.conf；此处只读，不再随机生成。
    local mac
    mac=$(jq -r .mac < "$VR_CONF" 2>/dev/null)
    
    if is_valid_mac "$mac"; then
        logger "Using MAC address from VR_CONF: $mac" \
            -t agent \
            -p daemon.info
        echo "$mac"
        return 0
    fi

    logger "MAC address not found or invalid in VR_CONF; wait for Paas identity save" \
        -t agent \
        -p daemon.notice
    echo ""
    return 1
}
get_uuid() {
	# 从VR_CONF文件中读取UUID
    local uuid=$(jq -r .uuid < "$VR_CONF" 2>/dev/null)
    
    # 如果UUID存在且不为空，直接返回
    if [ -n "$uuid" ] && [ "$uuid" != "null" ]; then
        echo "$uuid"
        return
    fi
