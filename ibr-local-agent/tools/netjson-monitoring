init_template() {
    local template_file="$1"
    local name="$2"
    local vpn="$3"
    local localsid="$4"
    local pool_id="$5"
    local uuid="$(get_uuid)"

    # 去除字符串中的回车符
    name=$(echo "$name" | tr -d '\r')
    vpn=$(echo "$vpn" | tr -d '\r')
    localsid=$(echo "$localsid" | tr -d '\r')
    pool_id=$(echo "$pool_id" | tr -d '\r')

    if [ ! -f "$template_file" ]; then
        echo '{
  "uuid": "'"$uuid"'",
  "srv6": {
    "name": "'"$name"'",
    "vpn": "'"$vpn"'",
    "localsid": "'"$localsid"'",
    "pool_id": "'"$pool_id"'",
    "srv6list": []
  },
  "interfaces": [],
  "resourceIndicators": {},
  "ipsec": [],
  "gateway": ""
}' > "$template_file"
    fi
}

add_srv6_config() {
    local input_file=$1    # 输入文件
    local name=$2
    local vpn=$3
    local localsid=$4
    local bsid=$5
    local seglist=$6       # 逗号分隔的seglist
    local ce_data=$7      # 格式: "router1,router2"
    local pool_id=$8
    
    # 确保模板文件存在
    init_template "$input_file" "$name" "$vpn" "$localsid" "$pool_id"
    
    # 转换route数据为数组
    local route_array=$(echo "$ce_data" | tr ',' '\n' | jq -R . | jq -s .)
    # 转换seglist为数组
    local seg_array=$(echo "$seglist" | tr ',' '\n' | jq -R . | jq -s .)
    
    # 添加新配置
    jq --arg bsid "$bsid" \
       --argjson seglist "$seg_array" \
       --argjson route "$route_array" \
       '.srv6.srv6list += [{
           "bsid": $bsid,
           "seglist": $seglist,
           "route": $route
       }]' "$input_file"
}


collect_srv6_data() {
	local name
    local vpn
    local localsid
    local seglist       # seglist
    local ce_data  ce_array     # 格式: "router1,router2"
	local BSID
	local policy
	local content
	local pool_id
	local vm_id
	local index=0
	

	local if=$(ip route | grep "default" | awk '{print $5}')
	name=$(ip addr show $if | grep "inet " |grep -v "inet6" | awk '{print $2}' | awk -F/ '{print $1}')
	vpn=$(vctl show sr localsids | grep "Table:" | tail -n 1 | awk '{print $2}')
	localsid=$(vctl show sr localsids | grep "Address:"| tail -n 1| awk '{print $2}'|awk -F/ '{print $1}')
	pool_id=$(jq -r .pool_id < "$VR_CONF")
	vm_id=$(jq -r .vm_id < "$VR_CONF")


	content=$(vctl show sr policies)
	content=$(echo "$content" | sed '/^SR policies:/d')

	while [ -n "$content" ]; do
		policy=$(echo "$content" | head -n 7)
		if [ -z "$policy" ]; then
			break
		fi
		BSID=$(echo "$policy" | grep "BSID:" | awk '{print $3}')
		seglist=$(echo "$policy" | grep "weight:"| awk '{print $3}'|sed 's/,$//')
		ce_array=$(vctl show sr steering-policies | grep "$BSID" | awk '{print $2}')
		ce_data=""
		for ce in $ce_array; do
			if [ -z "$ce_data" ]; then
    			ce_data="$ce"
			else
    			ce_data+=",$ce"
			fi
		done
		
		name=$(echo "$name" | tr -d '\r')
		vpn=$(echo "$vpn" | tr -d '\r')
		localsid=$(echo "$localsid" | tr -d '\r')
		BSID=$(echo "$BSID" | tr -d '\r')
		seglist=$(echo "$seglist" | tr -d '\r')
		ce_data=$(echo "$ce_data" | tr -d '\r')
		add_srv6_config "$CONF_DIR/conf.json" "$name" "$vpn" "$localsid" "$BSID" "$seglist" "$ce_data" "$pool_id" "$vm_id" > "$CONF_DIR/tmp_srv6.json" && mv "$CONF_DIR/tmp_srv6.json" "$CONF_DIR/conf.json"
		content=$(echo "$content" | sed '1,7d')
		((index++))
	done
	if [ "$index" -eq "0" ]; then
		add_srv6_config "$CONF_DIR/conf.json" "$name" "$vpn" "$localsid" "$BSID" "$seglist" "$ce_data" "$pool_id" "$vm_id" > "$CONF_DIR/tmp_srv6.json" && mv "$CONF_DIR/tmp_srv6.json" "$CONF_DIR/conf.json"
	fi 
}
