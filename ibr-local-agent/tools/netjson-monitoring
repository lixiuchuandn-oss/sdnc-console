add_interfaces_config() {
    local input_file="$CONF_DIR/conf.json"
    local name=$2
    local vlan=$3
    local vrf=$4
    local ipv4=$5
    local ipv6=$6
    local status=$7
    local rx_packets_rate=$8
    local rx_bytes_rate=$9
    local tx_packets_rate=${10}
    local tx_bytes_rate=${11}

    # 如果文件不存在，创建包含基本结构的文件
    if [ ! -f "$input_file" ]; then
        local uuid="$(get_uuid)"
        echo '{
            "uuid": "'"$uuid"'",
            "srv6": {
                "srv6list": []
            },
            "interfaces": [],
            "resourceIndicators": {},
            "ipsec": [],
            "gateway": ""
        }' > "$input_file"
    fi
    name=$(echo "$name" | tr -d '\r')
    vlan=$(echo "$vlan" | tr -d '\r')
    vrf=$(echo "$vrf" | tr -d '\r')
    ipv4=$(echo "$ipv4" | tr -d '\r')
    ipv6=$(echo "$ipv6" | tr -d '\r')
    status=$(echo "$status" | tr -d '\r')
    rx_packets_rate=$(echo "$rx_packets_rate" | tr -d '\r')
    rx_bytes_rate=$(echo "$rx_bytes_rate" | tr -d '\r')
    tx_packets_rate=$(echo "$tx_packets_rate" | tr -d '\r')
    tx_bytes_rate=$(echo "$tx_bytes_rate" | tr -d '\r')

    local data=''
    if [ -n "$name" ]; then
        data+='name: $name,'
    fi
    if [ -n "$vlan" ]; then
        data+='vlan: $vlan,'
    fi
    if [ -n "$ipv4" ]; then
        data+='ipv4_static: $ipv4,'
    fi
    if [ -n "$ipv6" ]; then
        data+='ipv6_static: $ipv6,'
    fi
    if [ -n "$vrf" -a "$vrf" != "default" ]; then
        data+='vrf: $vrf,'
    fi
    if [ -n "$status" ]; then
        data+='status: $status,'
    fi
    if [ -n "$rx_packets_rate" ] && [ "$rx_packets_rate" != "null" ]; then
        data+='receivePacketsPerSecond: ($rx_packets_rate | tonumber),'
    fi
    if [ -n "$rx_bytes_rate" ] && [ "$rx_bytes_rate" != "null" ]; then
        data+='receiveRateBps: ($rx_bytes_rate | tonumber),'
    fi
    if [ -n "$tx_packets_rate" ] && [ "$tx_packets_rate" != "null" ]; then
        data+='transmitPacketsPerSecond: ($tx_packets_rate | tonumber),'
    fi
    if [ -n "$tx_bytes_rate" ] && [ "$tx_bytes_rate" != "null" ]; then
        data+='transmitRateBps: ($tx_bytes_rate | tonumber),'
    fi
    data='.interfaces += [{
    '$data'
    }]'
    jq --arg name "$name" \
       --arg vlan "$vlan" \
       --arg vrf "$vrf" \
       --arg ipv4 "$ipv4" \
       --arg ipv6 "$ipv6" \
       --arg status "$status" \
       --arg rx_packets_rate "$rx_packets_rate" \
       --arg rx_bytes_rate "$rx_bytes_rate" \
       --arg tx_packets_rate "$tx_packets_rate" \
       --arg tx_bytes_rate "$tx_bytes_rate" \
       "$data" "$input_file" > "$CONF_DIR/tmp_interfaces.json" \
        && mv "$CONF_DIR/tmp_interfaces.json" "$input_file"
}
# 修改收集数据的函数
collect_interfaces_data() {
    local name
    local vlan
    local vrf
    local ipv4
    local ipv6
    local status
    local if_list
    local rx_packets_rate
    local rx_bytes_rate
    local tx_packets_rate
    local tx_bytes_rate
    local INTERVAL=${INTERVAL:-300}
    
    # 获取接口统计信息
    local interface_stats_json
    interface_stats_json=$(vctl show interface | lua /rhos/etc/agent/tools/lua/interface-fmt.lua 2>/dev/null)
    
    # 获取所有接口的名字
    if_list=$(vctl show tap-inject | awk -F "->" '{print $1}' | awk '{$1=$1};1')
    for if in $if_list; do
        prefix=$(echo "$if" | sed -E 's/([a-zA-Z]+)[0-9].*/\1/')
        number=$(echo "$if" | sed -E 's/[a-zA-Z]+([0-9].*)/\1/')
        if [ "$prefix" == "tap" ]; then
            prefix="TapEthernet"
            if="$prefix $number"
        fi
        name="$prefix $number"
        content=$(/rhos/bin/clish --lock --log -x /rhos/etc/cli/enable-view -c "show interface $prefix $number")
        vlan=$(echo "$content" | grep "outer vlan id" | awk -F ':' '{print $2}')
        vrf=$(echo "$content" | grep "vrf:" | awk '{print $2}'| sed 's/vrf//')
        ipv4=$(echo "$content" | grep "inet " | awk '{print $2}')
        ipv6=$(echo "$content" | grep "inet6 " | awk '{if(NR==2) print $2; if(NR==1 && FNR==1 && NR==1) print $2}')
        status=$(echo "$content" | head -n 1 | awk -F 'is ' '{print $2}' | awk -F ',' '{print $1}')

        # 从接口统计信息中获取该接口的计数器数据并计算速率
        rx_packets_rate=""
        rx_bytes_rate=""
        tx_packets_rate=""
        tx_bytes_rate=""
        
        if [ -n "$interface_stats_json" ]; then
            # 将接口名称转换为可能的格式（带空格和不带空格）
            # name可能是 "GigabitEthernet 0/3/0"，需要匹配 "GigabitEthernet0/3/0"
            local name_no_space=$(echo "$name" | tr -d ' ')
            local counters=$(echo "$interface_stats_json" | jq -r --arg ifname1 "$name" --arg ifname2 "$name_no_space" '.[] | select(.name == $ifname1 or .name == $ifname2) | .counters // {}')
            
            if [ -n "$counters" ] && [ "$counters" != "{}" ] && [ "$counters" != "null" ]; then
                local rx_packets=$(echo "$counters" | jq -r '.["rx packets"] // 0')
                local rx_bytes=$(echo "$counters" | jq -r '.["rx bytes"] // 0')
                local tx_packets=$(echo "$counters" | jq -r '.["tx packets"] // 0')
                local tx_bytes=$(echo "$counters" | jq -r '.["tx bytes"] // 0')
                
                # 计算速率（除以INTERVAL），使用awk进行浮点数计算
                # 即使值为0也计算速率，确保数据完整性
                if [ -n "$rx_packets" ] && [ "$rx_packets" != "null" ]; then
                    rx_packets_rate=$(awk "BEGIN {printf \"%.2f\", $rx_packets / $INTERVAL}" 2>/dev/null || echo "0")
                fi
                if [ -n "$rx_bytes" ] && [ "$rx_bytes" != "null" ]; then
                    rx_bytes_rate=$(awk "BEGIN {printf \"%.2f\", $rx_bytes / $INTERVAL}" 2>/dev/null || echo "0")
                fi
                if [ -n "$tx_packets" ] && [ "$tx_packets" != "null" ]; then
                    tx_packets_rate=$(awk "BEGIN {printf \"%.2f\", $tx_packets / $INTERVAL}" 2>/dev/null || echo "0")
                fi
                if [ -n "$tx_bytes" ] && [ "$tx_bytes" != "null" ]; then
                    tx_bytes_rate=$(awk "BEGIN {printf \"%.2f\", $tx_bytes / $INTERVAL}" 2>/dev/null || echo "0")
                fi
            fi
        fi

        add_interfaces_config "$CONF_DIR/conf.json" "$name" "$vlan" "$vrf" "$ipv4" "$ipv6" "$status" "$rx_packets_rate" "$rx_bytes_rate" "$tx_packets_rate" "$tx_bytes_rate"
    done
}
