{
  "name": "compute-tower-backend",
  "version": "1.0.3",
  "description": "Compute Tower SDNC IBR 控制台后端 API",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "set \"NODE_ENV=development\" && set \"PORT=5001\" && set \"DB_SYNC=true\" && set \"LOGIN_ALLOW_PLAINT_PASSWORD=1\" && set \"PRODUCT_FLAVOR=sdnc\" && set \"SDNC_NORTH_API_KEY=sdnc-north-lab-2026\" && nodemon --exec ts-node --transpile-only src/index.ts",
    "build": "tsc",
    "start": "set \"PORT=5001\" && node dist/src/index.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:ibr-local-web": "eslint -c .eslintrc.json \"../ibr-local-web/server/src/**/*.ts\" \"../ibr-local-web/web/src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:tests": "eslint -c ../tests/.eslintrc.json \"../tests/**/*.{js,cjs,mjs}\" --max-warnings=0",
    "lint:tools": "eslint -c ../tools/.eslintrc.json \"../tools/**/*.mjs\" --max-warnings=0",
    "lint:all": "npm run lint && npm run lint:ibr-local-web && npm run lint:tests && npm run lint:tools && npm run lint --prefix ../frontend",
    "test": "jest",
    "db:init": "ts-node --transpile-only scripts/dbInit.ts",
    "db:init-users": "ts-node --transpile-only scripts/initUsers.ts",
    "db:check-user": "ts-node --transpile-only scripts/checkUser.ts"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.1.13",
    "ssh2": "^1.16.0",
    "sqlite3": "^5.1.6",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/http-proxy-middleware": "^0.19.3",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.27",
    "@types/supertest": "^7.2.0",
    "@types/ssh2": "^1.15.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  }
}
