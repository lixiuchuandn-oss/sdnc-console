{
  "name": "compute-tower-backend",
  "version": "1.0.2",
  "description": "Compute Tower 多云管理平台后端API",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "set \"NODE_ENV=development\" && set \"PORT=5001\" && set \"DB_SYNC=true\" && set \"LOGIN_ALLOW_PLAINT_PASSWORD=1\" && nodemon --exec ts-node --transpile-only src/index.ts",
    "build": "tsc",
    "start": "set \"PORT=5001\" && node dist/src/index.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "test": "jest",
    "db:init": "ts-node --transpile-only scripts/dbInit.ts",
    "db:init-users": "ts-node --transpile-only scripts/initUsers.ts",
    "db:check-user": "ts-node --transpile-only scripts/checkUser.ts"
  },
  "dependencies": {
    "@alicloud/pop-core": "^1.7.10",
    "@aws-sdk/client-s3": "^3.1052.0",
    "@huaweicloud/huaweicloud-sdk-core": "^3.1.174",
    "@huaweicloud/huaweicloud-sdk-ecs": "^3.1.174",
    "@huaweicloud/huaweicloud-sdk-eip": "^3.1.174",
    "@huaweicloud/huaweicloud-sdk-elb": "^3.1.174",
    "@huaweicloud/huaweicloud-sdk-evs": "^3.1.174",
    "@huaweicloud/huaweicloud-sdk-nat": "^3.1.174",
    "@huaweicloud/huaweicloud-sdk-vpc": "^3.1.174",
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "docx-merger": "^1.2.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.5",
    "iconv-lite": "^0.7.2",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.1.13",
    "sqlite3": "^5.1.6",
    "ssh2": "^1.17.0",
    "tencentcloud-sdk-nodejs": "^4.1.141",
