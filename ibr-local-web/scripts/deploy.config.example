# 复制为 deploy.config 后填写（deploy.config 已在 .gitignore，勿在本文件写真实密码）
# 部署：npm run deploy:remote  或  powershell -File scripts/deploy.ps1

# —— 必填 ——
DEPLOY_HOST=120.26.76.215
DEPLOY_USER=
DEPLOY_REMOTE_DIR=/opt/paas-vr-v2

# SSH 认证二选一（只填其中一个）
DEPLOY_SSH_PASSWORD=
# DEPLOY_SSH_KEY=C:/Users/你的用户名/.ssh/id_rsa

# —— 可选 ——
DEPLOY_SSH_PORT=22
DEPLOY_HTTP_PORT=3000
DEPLOY_NODE_VERSION=22.17.0

# DEPLOY_NPM_REGISTRY=https://registry.npmmirror.com

# 测试环境：跳过 SSO JWT
DEPLOY_APPLY_DEV_BYPASS=true

# 注册 systemd 服务（需 root）
DEPLOY_SYSTEMD=true

# DEPLOY_SKIP_FIREWALL=false
# DEPLOY_REMOTE_POST_CMD=systemctl status paas-vr-v2.service
