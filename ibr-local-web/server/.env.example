PORT=3000
# LISTEN_HOST=0.0.0.0
NODE_ENV=development

# —— SSO / JWT（云平台下发 Access Token，本服务只校验）——
# 二选一：JWKS（推荐，OIDC）或 静态公钥 PEM
SSO_JWKS_URI=
# SSO_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
SSO_ISSUER=
SSO_AUDIENCE=

# 开发：跳过 JWT（切勿用于生产）
SSO_DEV_BYPASS=false
SSO_DEV_USER_ID=dev-local
SSO_DEV_USER_NAME=本地开发

# 前端同源生产构建目录（npm run build 后由 Node 托管）
WEB_DIST=../web/dist
